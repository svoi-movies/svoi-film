    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "refreshUrl": "http://localhost:8000/auth/refresh",
            "scopes": {},
            "tokenUrl": "http://localhost:8000/auth/login"
          }
        }
      }
