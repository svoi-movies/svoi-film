APP_SECRET_DIR_PATH=./.dev/secrets

# AUTH
APP_AUTH__TOKEN_URL=http://localhost:8001/auth/login
APP_AUTH__REFRESH_URL=http://localhost:8001/auth/refresh

# DB
APP_DB__DSN=postgresql+asyncpg://auth:auth@localhost:15432/auth
APP_DB__EXPIRE_ON_COMMIT=false

# JWT
APP_JWT__ACCESS_KEY_TTL=PT5M

# RABBIT
APP_RABBIT__DSN=amqp://rabbitmq:rabbitmq@localhost:5672

# MIGRATOR
APP_DB_DSN=postgresql+asyncpg://auth:auth@localhost:15432/auth