# Database
APP_DB__DSN=postgresql+asyncpg://user:password@localhost:5432/streaming

# RabbitMQ
APP_RABBIT__DSN=amqp://guest:guest@localhost:5672/

# S3 Configuration
APP_S3__ENDPOINT_URL=http://localhost:9000
APP_S3__ACCESS_KEY_ID=minioadmin
APP_S3__SECRET_ACCESS_KEY=minioadmin
APP_S3__BUCKET_NAME=streaming-videos
APP_S3__REGION_NAME=us-east-1
APP_S3__UPLOAD_EXPIRATION_SECONDS=3600
APP_S3__DOWNLOAD_EXPIRATION_SECONDS=3600
