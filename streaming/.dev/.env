APP_SECRET_DIR_PATH=./.dev/secrets

# PAYMENTS
APP_STREAMING__TOKEN_URL=http://localhost:8000/payments/login
APP_STREAMING__REFRESH_URL=http://localhost:8000/payments/refresh

# DB
APP_DB__DSN=postgresql+asyncpg://streaming:streaming@localhost:55432/streaming
APP_DB__EXPIRE_ON_COMMIT=false

# JWT
APP_JWT__ACCESS_KEY_TTL=PT5M

# RABBIT
APP_RABBIT__DSN=amqp://rabbitmq:rabbitmq@localhost:5672

# S3
APP_S3__ENDPOINT_URL=http://localhost:9000
APP_S3__ACCESS_KEY_ID=minioadmin
APP_S3__SECRET_ACCESS_KEY=minioadmin
APP_S3__BUCKET_NAME=streaming-videos
APP_S3__REGION_NAME=us-east-1
APP_S3__UPLOAD_EXPIRATION_SECONDS=3600
APP_S3__DOWNLOAD_EXPIRATION_SECONDS=3600

# MIGRATOR
APP_DB_DSN=postgresql+asyncpg://streaming:streaming@localhost:55432/streaming