  "components": {
    "schemas": {
      "AuthUserPayload": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "first_name": {
            "type": "string",
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "first_name",
          "last_name",
          "password"
        ],
        "title": "AuthUserPayload"
      },
      "CreateModerationRequest": {
        "properties": {
          "episode_id": {
            "type": "string",
            "format": "uuid",
            "title": "Episode Id"
          },
          "content_owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Content Owner Id"
          }
        },
        "type": "object",
        "required": [
          "episode_id",
          "content_owner_id"
        ],
        "title": "CreateModerationRequest"
      },
      "CreateModeratorRequest": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserPayload"
          }
        },
        "type": "object",
        "required": [
          "user"
        ],
        "title": "CreateModeratorRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModerationRequestResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "episode_id": {
            "type": "string",
            "format": "uuid",
            "title": "Episode Id"
          },
          "content_owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Content Owner Id"
          },
          "moderator_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Moderator Id"
          },
          "status": {
            "$ref": "#/components/schemas/ModerationRequestStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "episode_id",
          "content_owner_id",
          "moderator_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ModerationRequestResponse"
      },
      "ModerationRequestStatus": {
        "type": "string",
        "enum": [
          "requested",
          "approved",
          "rejected"
        ],
        "title": "ModerationRequestStatus"
      },
      "ModeratorResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "status": {
            "$ref": "#/components/schemas/ModeratorStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ModeratorResponse"
      },
      "ModeratorStatus": {
        "type": "string",
        "enum": [
          "active",
          "deleted"
        ],
        "title": "ModeratorStatus"
      },
      "ResolveModerationRequest": {
        "properties": {
          "moderator_id": {
            "type": "string",
            "format": "uuid",
            "title": "Moderator Id"
          }
        },
        "type": "object",
        "required": [
          "moderator_id"
        ],
        "title": "ResolveModerationRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "refreshUrl": "http://localhost:8001/auth/refresh",
            "scopes": {},
            "tokenUrl": "http://localhost:8001/auth/login"
          }
        }
      }
    }
